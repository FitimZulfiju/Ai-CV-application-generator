@if (Template == AiCV.Domain.Constants.CvTemplates.Professional)
{
    <AiCV.Web.Features.CvRendering.Templates.Professional.ProfessionalCoverLetter Profile="Profile" LetterContent="@LetterContent" />
}
else if (Template == AiCV.Domain.Constants.CvTemplates.Modern)
{
    <AiCV.Web.Features.CvRendering.Templates.Modern.ModernCoverLetter Profile="Profile" LetterContent="@LetterContent" />
}
else if (Template == AiCV.Domain.Constants.CvTemplates.Minimalist)
{
    <AiCV.Web.Features.CvRendering.Templates.Minimalist.MinimalistCoverLetter Profile="Profile" LetterContent="@LetterContent" />
}
