@attribute [Microsoft.AspNetCore.Components.Route(NavUri.ErrorPage)]

@inject NavigationManager Navigation
@inject IStringLocalizer<AiCV.Infrastructure.Resources.AicvResources> Localizer

<PageTitle>@Localizer["ErrorPageServerError"]</PageTitle>

<div style="display:flex;align-items:center;justify-content:center;height:75vh;padding:2rem;">
    <MudPaper Elevation="4" Class="pa-6" Style="max-width:900px;width:100%;">
        <div style="display:flex;gap:2rem;align-items:flex-start;">
            <div style="flex:0 0 140px;text-align:center;">
                <div style="font-size:4.5rem;font-weight:800;color:var(--mud-palette-error)">500</div>
            </div>
            <div style="flex:1;">
                <h1 style="margin:0 0 .5rem 0;">@Localizer["ErrorPageUnexpectedError"]</h1>
                <p style="margin:0 0 1rem 0;color:var(--mud-palette-text-secondary);">@Localizer["ErrorPageUnexpectedErrorMessage"]</p>

                @if (ShowRequestId)
                {
                    <div style="margin-bottom:1rem;"><strong>@Localizer["ErrorPageRequestId"]</strong> <code>@RequestId</code></div>
                }

                <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">@Localizer["ErrorPageGoHome"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo($"/{NavUri.LoginPage}"))">@Localizer["ErrorPageSignIn"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Href="javascript:history.back()">@Localizer["ErrorPageGoBack"]</MudButton>
                </div>
            </div>
        </div>
    </MudPaper>
</div>
