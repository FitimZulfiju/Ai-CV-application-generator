@attribute [Microsoft.AspNetCore.Components.Route(NavUri.ResetPasswordPage)]

<PageTitle>@Localizer["ResetPassword"] - Ai-CV</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4 d-flex flex-column align-center justify-center"
    Style="min-height: 80vh;">
    <MudPaper Class="pa-6" Elevation="3" Style="width: 100%;">
        <div class="d-flex justify-center mb-6">
            <MudImage Src="/logoSvg.svg" Alt="AiCV Logo" Width="100" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">@Localizer["ResetPassword"]</MudText>
        
        <MudText Typo="Typo.body2" Class="mb-4 text-center">
            @Localizer["ResetPasswordInstructions"]
        </MudText>

        <EditForm Model="this" OnValidSubmit="HandleResetPassword">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="NewPassword" Label="@Localizer["NewPassword"]"
                Variant="Variant.Outlined" InputType="MudBlazor.InputType.Password" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Lock" Class="mb-3" Required="true"
                For="@(() => NewPassword)" HelperText="@Localizer["PasswordRequirementHelper"]" />

            <MudTextField @bind-Value="ConfirmPassword" Label="@Localizer["ConfirmPassword"]"
                Variant="Variant.Outlined" InputType="MudBlazor.InputType.Password" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Lock" Class="mb-3" Required="true"
                For="@(() => ConfirmPassword)" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                FullWidth="true" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_isProcessing || string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">@Localizer["Processing"]</MudText>
                }
                else
                {
                    @Localizer["ResetPassword"]
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-4" />

        <MudText Align="Align.Center">
            <MudLink Href="@($"/{NavUri.LoginPage}")">@Localizer["BackToLogin"]</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>
