@attribute [Microsoft.AspNetCore.Components.Route(NavUri.LoginPage)]

<PageTitle>@Localizer["LoginTitle"] - Ai-CV</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="py-4 d-flex flex-column align-center justify-center"
    Style="min-height: 80vh;">
    <MudPaper Class="pa-6" Elevation="3" Style="width: 100%;">
        <div class="d-flex justify-center mb-6">
            <MudImage Src="/logoSvg.svg" Alt="AiCV Logo" Width="100" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">@Localizer["LoginTitle"]</MudText>

        <MudPaper Outlined="true" Class="pa-3 mb-4 d-flex align-center justify-space-between" Style="background-color: var(--mud-palette-background-grey); border-color: var(--mud-palette-info); border-width: 1px; border-style: solid;">
            <MudText Typo="Typo.body2">
                <strong>@Localizer["DemoAccountInfo"]:</strong> @AiCV.Application.Common.DemoConstants.DemoUserEmail <br/>
                <strong>@Localizer["Password"]:</strong> @AiCV.Application.Common.DemoConstants.DemoUserPassword
            </MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="FillDemoCredentials" Style="white-space: nowrap;">
                @Localizer["FillDemoCredentials"]
            </MudButton>
        </MudPaper>

        <form method="post" action="/perform-login">

            <MudTextField T="string" @bind-Value="_email"
                UserAttributes="@(new Dictionary<string, object> { { "name", "email" } })" Label="@Localizer["Email"]"
                Variant="Variant.Outlined" InputType="InputType.Email" Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Email" Class="mb-3" Required="true" Clearable="true" />

            <MudTextField T="string" @bind-Value="_password"
                UserAttributes="@(new Dictionary<string, object> { { "name", "password" } })"
                Label="@Localizer["Password"]" Variant="Variant.Outlined" InputType="@PasswordInputType"
                Adornment="Adornment.End" AdornmentIcon="@PasswordIcon" OnAdornmentClick="TogglePasswordVisibility"
                AdornmentAriaLabel="Toggle password visibility" Class="mb-3" Required="true" Clearable="true" />

            <div class="d-flex align-center justify-space-between mb-3">
                <div class="d-flex align-center">
                    <input type="hidden" name="rememberMe" value="@(_rememberMe.ToString().ToLower())" />
                    <MudCheckBox T="bool" @bind-Value="_rememberMe" Label="@Localizer["RememberMe"]"
                        Color="Color.Primary" />
                </div>
                <MudLink Href="@($"/{NavUri.ForgotPasswordPage}")">@Localizer["ForgotPassword"]?</MudLink>
            </div>

            @if (ResetSuccess == true)
            {
                <MudAlert Severity="Severity.Success" Class="mb-3">@Localizer["PasswordResetSuccessMessage"]</MudAlert>
            }

            @if (!string.IsNullOrEmpty(Error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@Localizer[Error]</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                FullWidth="true" StartIcon="@Icons.Material.Filled.Login">@Localizer["Login"]</MudButton>
        </form>

        <MudDivider Class="my-4" />

        @if (HasAnyExternalProvider)
        {
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-3" Color="Color.Secondary">@Localizer["OrSignInWith"]
            </MudText>

            <div class="d-flex justify-center gap-4">
                @if (IsGoogleConfigured)
                {
                    <MudIconButton Href="/external-login/Google" Variant="Variant.Outlined"
                        Icon="@Icons.Custom.Brands.Google" Style="border-color: #DB4437; color: #DB4437;" />
                }
                @if (IsMicrosoftConfigured)
                {
                    <MudIconButton Href="/external-login/Microsoft" Variant="Variant.Outlined"
                        Icon="@Icons.Custom.Brands.Microsoft" Style="border-color: #00a4ef; color: #00a4ef;" />
                }
                @if (IsGitHubConfigured)
                {
                    <MudIconButton Href="/external-login/GitHub" Variant="Variant.Outlined"
                        Icon="@Icons.Custom.Brands.GitHub" Style="border-color: #333; color: #333;" />
                }
            </div>

            <MudDivider Class="my-4" />
        }

        <MudText Align="Align.Center">
            @Localizer["DontHaveAccount"] <MudLink Href="/register">@Localizer["RegisterHere"]</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>
