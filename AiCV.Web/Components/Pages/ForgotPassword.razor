@attribute [Microsoft.AspNetCore.Components.Route(NavUri.ForgotPasswordPage)]

<PageTitle>@Localizer["ForgotPassword"] - Ai-CV</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4 d-flex flex-column align-center justify-center"
    Style="min-height: 80vh;">
    <MudPaper Class="pa-6" Elevation="3" Style="width: 100%;">
        <div class="d-flex justify-center mb-6">
            <MudImage Src="/logoSvg.svg" Alt="AiCV Logo" Width="100" />
        </div>
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">@Localizer["ForgotPassword"]</MudText>
        
        @if (_success)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                @Localizer["ForgotPasswordSuccessMessage"]
            </MudAlert>

            @if (!string.IsNullOrEmpty(_devResetLink))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-1"><strong>[Dev Mode Only]</strong> Password Reset Link:</MudText>
                    <MudLink Href="@_devResetLink" Underline="Underline.Always">Click here to reset your password</MudLink>
                </MudAlert>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="@($"/{NavUri.LoginPage}")" Class="mt-2">
                @Localizer["BackToLogin"]
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4 text-center">
                @Localizer["ForgotPasswordInstructions"]
            </MudText>

            <EditForm Model="this" OnValidSubmit="HandleForgotPassword">
                <DataAnnotationsValidator />
                
                <MudTextField @bind-Value="Email" Label="@Localizer["Email"]"
                    Variant="Variant.Outlined" InputType="MudBlazor.InputType.Email" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Email" Class="mb-3" Required="true"
                    For="@(() => Email)" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                    FullWidth="true" StartIcon="@Icons.Material.Filled.Email" Disabled="_isProcessing">
                    @if (_isProcessing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">@Localizer["Processing"]</MudText>
                    }
                    else
                    {
                        @Localizer["SendResetLink"]
                    }
                </MudButton>
            </EditForm>

            <MudDivider Class="my-4" />

            <MudText Align="Align.Center">
                <MudLink Href="@($"/{NavUri.LoginPage}")">@Localizer["BackToLogin"]</MudLink>
            </MudText>
        }
    </MudPaper>
</MudContainer>
