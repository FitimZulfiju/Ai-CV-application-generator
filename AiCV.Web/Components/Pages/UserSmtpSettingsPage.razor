<div class="flex-grow-1">
    <div class="d-flex align-center justify-space-between pb-3">
        <MudText Typo="Typo.h6" Class="settings-title-nowrap d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Email" /> @Localizer["EmailSendingSettings"]
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Localizer["EmailSendingSettingsSubtitle"]
        </MudText>
    </div>
    @if (_isLoading)
    {
        <div class="d-flex justify-center align-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else
    {
        @if (_isSaved)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" ShowCloseIcon="true" CloseIconClicked="() => _isSaved = false" Class="mb-4">
                @Localizer["SettingsSavedSuccessfully"]
            </MudAlert>
        }

        <MudForm Model="@_settings" @ref="_form">
            <MudPaper Elevation="2" Class="pa-4 pb-0 mb-0">
                <div class="d-flex flex-column flex-md-row gap-6">
                    <!-- SMTP Server Configuration -->
                    <div class="d-flex flex-column gap-4" style="flex: 1 1 0; min-width: 0;">
                        <MudText Typo="Typo.h6">@Localizer["SmtpServerConfiguration"]</MudText>
                        <MudTextField @bind-Value="_settings.SmtpHost" Label="@Localizer["HostServerAddress"]"
                                      Placeholder="smtp.gmail.com" Variant="Variant.Outlined"
                                      Required="true" RequiredError="@Localizer["HostIsRequired"]" />
                        <div class="d-flex align-center gap-4">
                            <MudNumericField @bind-Value="_settings.SmtpPort" Label="@Localizer["Port"]"
                                             Variant="Variant.Outlined" Required="true" Min="1" Max="65535"
                                             Class="flex-grow-1" Style="min-width: 0;" />
                            <MudCheckBox @bind-Value="_settings.EnableSsl" Label="@Localizer["EnableSslTls"]" Color="Color.Primary" />
                        </div>
                    </div>

                    <MudDivider Vertical="true" FlexItem="true" />

                    <!-- Authentication -->
                    <div class="d-flex flex-column gap-4" style="flex: 1 1 0; min-width: 0;">
                        <MudText Typo="Typo.h6">@Localizer["Authentication"]</MudText>
                        <MudTextField @bind-Value="_settings.SmtpUser" Label="@Localizer["UsernameEmail"]"
                                      Variant="Variant.Outlined" Required="true" RequiredError="@Localizer["UsernameIsRequired"]" />
                        <MudTextField @bind-Value="_settings.SmtpPassword" Label="@Localizer["SmtpPasswordLabel"]"
                                      Variant="Variant.Outlined" InputType="InputType.Password"
                                      Required="true" RequiredError="@Localizer["PasswordIsRequired"]" />
                    </div>

                    <MudDivider Vertical="true" FlexItem="true" />

                    <!-- Sender Information -->
                    <div class="d-flex flex-column gap-4" style="flex: 1 1 0; min-width: 0;">
                        <MudText Typo="Typo.h6">@Localizer["SenderInformation"]</MudText>
                        <MudTextField @bind-Value="_settings.FromName" Label="@Localizer["FromName"]"
                                      Placeholder="John Doe" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_settings.FromEmail" Label="@Localizer["FromEmailAddress"]"
                                      Placeholder="john@example.com" Variant="Variant.Outlined" />
                    </div>
                </div>
            </MudPaper>
            <div class="d-flex justify-end gap-3 mt-6">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           Disabled="@_isTestingConnection" OnClick="TestConnection"
                           StartIcon="@(_isTestingConnection ? null : Icons.Material.Filled.BugReport)">
                    @if (_isTestingConnection)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @Localizer["TestConnection"]
                </MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="@_isSaving" OnClick="SaveSettings"
                           StartIcon="@(_isSaving ? null : Icons.Material.Filled.Save)">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @Localizer["SaveSettings"]
                </MudButton>
            </div>
        </MudForm>

        @if (!string.IsNullOrEmpty(_testResult))
        {
            <MudAlert Severity="@(_testSuccess ? Severity.Success : Severity.Error)" Variant="Variant.Filled" Class="mt-4">
                <MudText Typo="Typo.subtitle2">@_testResult</MudText>
                @if (!_testSuccess && !string.IsNullOrEmpty(_testErrorDetails))
                {
                    <MudText Typo="Typo.caption" Style="font-family: monospace; word-break: break-all;">@_testErrorDetails</MudText>
                }
            </MudAlert>
        }
    }
</div>
