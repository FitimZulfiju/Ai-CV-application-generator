@attribute [Microsoft.AspNetCore.Components.Route(NavUri.AutomationSettingsPage)]
@attribute [Authorize]

<PageTitle>@Localizer["JobAutomation"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <div class="d-flex align-center justify-space-between pb-3">
        <MudText Typo="Typo.h5" Class="settings-title-nowrap d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" /> @Localizer["AutomationSettings"]
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Localizer["AutomationSettingsSubtitle"]
        </MudText>
    </div>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_settings is not null)
    {
        <MudPaper Elevation="4" Class="pa-4 mb-2">
            <MudText Typo="Typo.h6" Class="mb-4 section-header-divider">@Localizer["GeneralConfiguration"]</MudText>

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6" md="3" lg="2" Class="d-flex align-center pb-4">
                    <MudSwitch T="bool" @bind-Value="_settings.IsEnabled" Color="Color.Primary"
                               Label="@Localizer["EnableAutomation"]" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3" lg="3">
                    <MudSelect T="string" Label="@Localizer["CronPresets"]" @bind-Value="_selectedPreset"
                               @bind-Value:after="ApplyPreset" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@PresetDaily6">@Localizer["Daily6AM"]</MudSelectItem>
                        <MudSelectItem Value="@PresetDaily8">@Localizer["Daily8AM"]</MudSelectItem>
                        <MudSelectItem Value="@PresetWeekdays7">@Localizer["Weekdays7AM"]</MudSelectItem>
                        <MudSelectItem Value="@PresetCustom">@Localizer["Custom"]</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="3" lg="4">
                    <MudTextField T="string" @bind-Value="_settings.CronExpression"
                                  Label="@Localizer["CronExpression"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  HelperText="@Localizer["CronExpressionHelper"]" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3" lg="3">
                    <MudNumericField T="int" @bind-Value="_settings.MaxApplicationsPerRun" Min="1" Max="50"
                                     Label="@Localizer["MaxApplicationsPerRun"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* Add New Provider Configuration Panel *@
        <MudPaper Elevation="4" Class="pa-4 mb-2">
            <div class="d-flex align-center justify-space-between mb-4">
                <div class="d-flex align-baseline gap-3 flex-wrap">
                    <MudText Class="ma-0 settings-title-nowrap" Typo="Typo.h6">@(_editingConfig == null ? Localizer["AddProviderConfiguration"] : Localizer["EditProviderConfiguration"])</MudText>
                    <MudText Class="ma-0" Typo="Typo.body2" Color="Color.Secondary">@Localizer["ProviderConfigurationSubtitle"]</MudText>
                </div>
                <div class="d-flex align-center">
                    @if (_editingConfig != null)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Default" Class="mr-2" OnClick="CancelEdit" Size="Size.Small">
                            @Localizer["Cancel"]
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(_editingConfig == null ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                               Size="Size.Small" OnClick="AddProviderConfig" Disabled="@(!CanAddProvider)">
                        @Localizer["Save"]
                    </MudButton>
                </div>
            </div>

            <MudGrid Spacing="2">
                <MudItem xs="12" md="4" sm="4">
                    <MudAutocomplete T="string" @bind-Value="_newProviderConfig.Provider" SearchFunc="@SearchProviders"
                                     Label="@Localizer["ProviderName"]" Margin="Margin.Dense" Variant="Variant.Outlined" Placeholder="e.g. LinkedIn"
                                     ResetValueOnEmptyText="false" CoerceValue="true" CoerceText="true" />
                </MudItem>
                <MudItem xs="12" md="4" sm="4">
                    <MudTextField T="string" @bind-Value="_newProviderConfig.ApiKey" Label="@Localizer["RapidApiKey"]"
                                  Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="4" sm="4">
                    <MudTextField T="string" @bind-Value="_newProviderConfig.ApiHost" Label="@Localizer["ApiHost"]"
                                  Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* Grid of Configured Providers *@
        <MudPaper Elevation="4" Class="pa-4 mb-2">
            <MudText Typo="Typo.h6" GutterBottom="true">@Localizer["ConfiguredProviders"]</MudText>

            @if (_providerConfigs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @Localizer["NoProvidersConfigured"]
                </MudAlert>
            }
            else
            {
                <MudTable Items="_providerConfigs" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" RowClassFunc="GetProviderRowClass">
                    <HeaderContent>
                        <MudTh>@Localizer["Provider"]</MudTh>
                        <MudTh>@Localizer["RapidApiKey"]</MudTh>
                        <MudTh>@Localizer["ApiHost"]</MudTh>
                        <MudTh>@Localizer["Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@Localizer["Provider"]">
                            <MudText Typo="Typo.body2">@context.Provider</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["RapidApiKey"]">
                            <MudText Typo="Typo.body2">@(!string.IsNullOrEmpty(context.ApiKey) ? new string('*', Math.Min(context.ApiKey.Length, 8)) + "..." : "")</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["ApiHost"]">
                            <MudText Typo="Typo.body2">@context.ApiHost</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["Actions"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => EditProviderConfig(context)" aria-label="edit" Class="mr-1" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => RemoveProviderConfig(context)" aria-label="delete" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Elevation="4" Class="pa-4 mb-2" id="queries-form-section">
            <div class="d-flex align-baseline gap-3 flex-wrap mb-4 section-header-divider">
                <MudText Typo="Typo.h6" Class="ma-0 settings-title-nowrap">@(_editingQuery == null ? Localizer["AddSearchQuery"] : Localizer["EditSearchQuery"])</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ma-0">@Localizer["SearchQueriesSubtitle"]</MudText>
            </div>

            @* Search Query Form *@
            <MudGrid Spacing="2" Class="mb-4 align-end">
                <MudItem xs="12" md="3">
                    <TagInputContainer Label="@Localizer["RoleOrKeywords"]"
                                       @bind-Tags="_newQueryTexts"
                                       Placeholder="@Localizer["QueryPlaceholder"]"
                                       SearchFunc="SearchQueries" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <TagInputContainer Label="@Localizer["Provider"]"
                                       @bind-Tags="_newQueryProviders"
                                       Placeholder="@Localizer["ProviderPlaceholder"]"
                                       SearchFunc="SearchConfiguredProviders" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <TagInputContainer Label="@Localizer["Location"]"
                                       @bind-Tags="_newQueryLocations"
                                       Placeholder="@Localizer["LocationPlaceholder"]"
                                       SearchFunc="SearchLocations" />
                </MudItem>
                <MudItem xs="6" md="1">
                    <MudNumericField T="int" @bind-Value="_newQueryMaxResults" Label="@Localizer["MaxResults"]" Min="1" Max="100" Margin="Margin.Dense" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6" md="1">
                    <MudNumericField T="int" @bind-Value="_newQueryJobAgeDays" Label="@Localizer["JobAge"]" Min="1" Max="90" Margin="Margin.Dense" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="1" Class="d-flex justify-end pb-2 gap-1">
                    @if (_editingQuery != null)
                    {
                        <MudTooltip Text="@Localizer["Cancel"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Variant="Variant.Outlined"
                                           Size="Size.Small" OnClick="CancelEditQuery" aria-label="@Localizer["Cancel"]" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer["Save"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Primary" Variant="Variant.Filled"
                                           Size="Size.Small" OnClick="SaveQueryFromForm" aria-label="@Localizer["Save"]" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="SaveQueryFromForm" Size="Size.Small" FullWidth="true">
                            @Localizer["Add"]
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Localizer["ConfiguredSearchQueries"]</MudText>

            @if (_settings.Queries.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @Localizer["NoQueriesConfigured"]
                </MudAlert>
            }
            else
            {
                <MudTable Items="_settings.Queries" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" RowClassFunc="GetQueryRowClass">
                    <HeaderContent>
                        <MudTh>@Localizer["RoleOrKeywords"]</MudTh>
                        <MudTh>@Localizer["Provider"]</MudTh>
                        <MudTh>@Localizer["Location"]</MudTh>
                        <MudTh>@Localizer["MaxResults"]</MudTh>
                        <MudTh>@Localizer["JobAge"]</MudTh>
                        <MudTh>@Localizer["Active"]</MudTh>
                        <MudTh>@Localizer["Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@Localizer["RoleOrKeywords"]">
                            <MudText Typo="Typo.body2">@context.Query</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["Provider"]">
                            <MudText Typo="Typo.body2">@context.Provider</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["Location"]">
                            <MudText Typo="Typo.body2">@context.Location</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["MaxResults"]">
                            <MudText Typo="Typo.body2">@context.MaxResults</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["JobAge"]">
                            <MudText Typo="Typo.body2">@context.JobAgeDays</MudText>
                        </MudTd>
                        <MudTd DataLabel="@Localizer["Active"]">
                            <MudSwitch T="bool" @bind-Value="context.IsActive" @bind-Value:after="SaveSettings" Color="Color.Success" Class="ma-0" />
                        </MudTd>
                        <MudTd DataLabel="@Localizer["Actions"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => EditQuery(context)" aria-label="@Localizer["Edit"]" title="@Localizer["Edit"]" Class="mr-1" />
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary" Size="Size.Small"
                                           OnClick="() => DuplicateQuery(context)" aria-label="@Localizer["Duplicate"]" title="@Localizer["Duplicate"]" Class="mr-1" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="() => RemoveQuery(context)" aria-label="@Localizer["DeleteAriaLabel"]" title="@Localizer["DeleteAriaLabel"]" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudGrid Class="pt-4 align-center">
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["LastRun"]:
                    <strong class="ms-1 timestamp-text">@(_settings.LastRunUtc?.ToLocalTime().ToString("g") ?? "—")</strong>
                </MudText>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localizer["NextRun"]:
                    <strong class="ms-1 timestamp-text">@(_settings.NextRunUtc?.ToLocalTime().ToString("g") ?? "—")</strong>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           OnClick="RunTestNow" StartIcon="@(_isRunning ? null : Icons.Material.Filled.PlayArrow)" Disabled="_isRunning">
                    @if (_isRunning)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @Localizer["TestRunNow"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="SaveSettings" StartIcon="@(_isRunning ? null : Icons.Material.Filled.Save)" Disabled="_isRunning">
                    @Localizer["SaveSettings"]
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrEmpty(_testDebugLog))
        {
            <MudPaper Elevation="2" Class="pa-4 mb-6 debug-log-paper">
                <MudText Typo="Typo.subtitle2" Class="mb-2 debug-log-title">@Localizer["TestRunDebugLog"]</MudText>
                <pre class="debug-log-pre">@_testDebugLog</pre>
            </MudPaper>
        }
    }
</MudContainer>
