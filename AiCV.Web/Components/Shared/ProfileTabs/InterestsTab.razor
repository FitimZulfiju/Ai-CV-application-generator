@if (Profile != null)
{
    <SectionHeaderCard Section="Profile.InterestsSection" DefaultNameKey="InterestsCv" />

    var isEditing = _editingInterest != null;

    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        <MudButton StartIcon="@(isEditing ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveInterest">
            @(isEditing ? Localizer["Update"] : Localizer["AddInterest"])
        </MudButton>
        @if (isEditing)
        {
            <MudTooltip Text="@Localizer["Cancel"]">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Outlined" OnClick="CancelInterestEdit" />
            </MudTooltip>
        }
        <div class="d-none d-sm-flex flex-grow-1">
            @if (_showChipHelp)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Icon="@Icons.Material.Filled.Info" ShowCloseIcon="true" CloseIconClicked="() => _showChipHelp = false" Class="profile-chip-help-row">
                    @Localizer["ProfileChipHelp"]
                </MudAlert>
            }
        </div>
        <MudSwitch T="bool" @bind-Value="Profile.InterestsSection.DisplayAsChips" Size="Size.Small" Color="Color.Primary" Label="@Localizer["DisplayAsChips"]" Class="ml-auto" />
    </MudStack>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="12">
            <MudTextField @bind-Value="_newInterest" Label="@Localizer["AddInterest"]" Variant="Variant.Outlined" Clearable="true" Immediate="true" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>

    <MudStack Spacing="4" Class="pt-0">
        <div class="profile-chip-container">
            @foreach (var interest in Profile.Interests)
            {
                var interestIndex = Profile.Interests.IndexOf(interest);
                var isFirstInterest = interestIndex == 0;
                var isLastInterest = interestIndex == Profile.Interests.Count - 1;

                <MudChip T="Interest" Value="interest" Color="@GetInterestChipColor(interest)" Variant="@GetInterestChipVariant(interest)" Class="profile-chip">
                    <span class="profile-chip-content">
                        <FormattedText Text="@interest.Name" />
                        <span class="profile-chip-edit-action" @onclick:stopPropagation="true">
                            <MudTooltip Text="@Localizer["MoveLeft"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@isFirstInterest" Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MoveInterestLeft(interest))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["MoveRight"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@isLastInterest" Size="Size.Small" Variant="Variant.Text" OnClick="@(() => MoveInterestRight(interest))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Text" OnClick="@(() => BeginInterestEdit(interest))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["Remove"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Variant="Variant.Text" OnClick="@(() => RemoveInterest(interest))" />
                            </MudTooltip>
                        </span>
                    </span>
                </MudChip>
            }
        </div>
    </MudStack>
}

