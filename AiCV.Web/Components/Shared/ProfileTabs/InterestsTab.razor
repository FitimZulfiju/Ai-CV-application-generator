@if (Profile != null)
{
    <MudCard Class="mb-2 mud-elevation-1" Style="background-color: var(--mud-palette-background-grey);">
        <MudCardContent Class="py-1 px-4">
            <MudText Typo="Typo.subtitle2" Class="mb-1">@Localizer["CustomSectionHeader"]</MudText>
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Profile.InterestsSection.Title"
                                  Label="@Localizer["SectionTitle"]"
                                  HelperText="@string.Format(Localizer["LeaveBlankToUseDefault"].Value, Localizer["InterestsCv"].Value)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <UnicodeIconPicker @bind-Icon="Profile.InterestsSection.Icon" Label="@Localizer["SectionIcon"]" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    var isEditing = _editingInterest != null;

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudButton StartIcon="@(isEditing ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveInterest">
            @(isEditing ? Localizer["Update"] : Localizer["AddInterest"])
        </MudButton>
        @if (isEditing)
        {
            <MudTooltip Text="@Localizer["Cancel"]">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               OnClick="CancelInterestEdit" />
            </MudTooltip>
        }
        <MudSwitch T="bool" @bind-Value="Profile.InterestsSection.DisplayAsChips" Color="Color.Primary" Label="@Localizer["DisplayAsChips"]" Class="ml-auto" />
    </MudStack>

    <MudStack Spacing="4" Class="pt-0">

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="12">
                <MudTextField @bind-Value="_newInterest"
                              Label="@Localizer["AddInterest"]"
                              Variant="Variant.Outlined"
                              Immediate="true" />
            </MudItem>
        </MudGrid>

        <MudDropContainer @ref="_dropContainer"
                          T="Interest"
                          Items="Profile.Interests"
                          ItemsSelector="@((Interest item, string zone) => zone == InterestsDropZone)"
                          ItemDropped="OnInterestDropped"
                          Class="profile-chip-drop-container">
            <ChildContent>
                <MudDropZone T="Interest"
                             Identifier="@InterestsDropZone"
                             AllowReorder="true"
                             Class="profile-chip-drop-zone" />
            </ChildContent>
            <ItemRenderer>
                <MudChip T="Interest"
                         Value="context"
                         Color="@GetInterestChipColor(context)"
                         Variant="@GetInterestChipVariant(context)"
                         OnClose="@((MudChip<Interest> chip) => RemoveInterest(context))"
                         Class="profile-draggable-chip">
                    <span class="profile-chip-content">
                        <FormattedText Text="@context.Name" />
                        <span class="profile-chip-edit-action" @onclick:stopPropagation="true">
                            <MudTooltip Text="@Localizer["Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Variant="Variant.Text"
                                               OnClick="@(() => BeginInterestEdit(context))" />
                            </MudTooltip>
                        </span>
                    </span>
                </MudChip>
            </ItemRenderer>
        </MudDropContainer>

        @if (_showChipHelp)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Text"
                      Dense="true"
                      Icon="@Icons.Material.Filled.Info"
                      ShowCloseIcon="true"
                      CloseIconClicked="() => _showChipHelp = false"
                      Class="profile-chip-help-row">
                @Localizer["ProfileChipHelp"]
            </MudAlert>
        }
    </MudStack>
}

