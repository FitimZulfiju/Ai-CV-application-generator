@if (Profile != null)
{
    <MudStack Spacing="3">
        @{
            var isEditing = _editingInterest != null;
        }

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="10">
                <MudTextField @bind-Value="_newInterest"
                              Label="@Localizer["AddInterest"]"
                              Variant="Variant.Outlined"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center gap-1">
                <MudButton StartIcon="@(isEditing ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="SaveInterest">
                    @(isEditing ? Localizer["Update"] : Localizer["AddInterest"])
                </MudButton>
                @if (isEditing)
                {
                    <MudTooltip Text="@Localizer["Cancel"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Default"
                                       Variant="Variant.Outlined"
                                       OnClick="CancelInterestEdit" />
                    </MudTooltip>
                }
            </MudItem>
        </MudGrid>

        <MudDropContainer @ref="_dropContainer"
                          T="Interest"
                          Items="Profile.Interests"
                          ItemsSelector="@((Interest item, string zone) => zone == InterestsDropZone)"
                          ItemDropped="OnInterestDropped"
                          Class="profile-chip-drop-container">
            <ChildContent>
                <MudDropZone T="Interest"
                             Identifier="@InterestsDropZone"
                             AllowReorder="true"
                             Class="profile-chip-drop-zone" />
            </ChildContent>
            <ItemRenderer>
                <MudChip T="Interest"
                         Value="context"
                         Color="@GetInterestChipColor(context)"
                         Variant="@GetInterestChipVariant(context)"
                         OnClose="@((MudChip<Interest> chip) => RemoveInterest(context))"
                         Class="profile-draggable-chip">
                    <span class="profile-chip-content">
                        <FormattedText Text="@context.Name" />
                        <span class="profile-chip-edit-action" @onclick:stopPropagation="true">
                            <MudTooltip Text="@Localizer["Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Variant="Variant.Text"
                                               OnClick="@(() => BeginInterestEdit(context))" />
                            </MudTooltip>
                        </span>
                    </span>
                </MudChip>
            </ItemRenderer>
        </MudDropContainer>

        @if (_showChipHelp)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Text"
                      Dense="true"
                      Icon="@Icons.Material.Filled.Info"
                      ShowCloseIcon="true"
                      CloseIconClicked="() => _showChipHelp = false"
                      Class="profile-chip-help-row">
                @Localizer["ProfileChipHelp"]
            </MudAlert>
        }
    </MudStack>
}
