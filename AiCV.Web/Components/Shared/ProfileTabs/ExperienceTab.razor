@if (Profile != null)
{
    <MudCard Class="mb-2 mud-elevation-1" Style="background-color: var(--mud-palette-background-grey);">
        <MudCardContent Class="py-1 px-4">
            <MudText Typo="Typo.subtitle2" Class="mb-1">@Localizer["CustomSectionHeader"]</MudText>
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="Profile.ExperienceSection.Title"
                                  Label="@Localizer["SectionTitle"]"
                                  HelperText="@string.Format(Localizer["LeaveBlankToUseDefault"].Value, Localizer["WorkExperienceCv"].Value)"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <UnicodeIconPicker @bind-Icon="Profile.ExperienceSection.Icon" Label="@Localizer["SectionIcon"]" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddExperience" Class="mb-2"
               StartIcon="@Icons.Material.Filled.Add">@Localizer["AddExperience"]</MudButton>

    <MudStack Spacing="4">
        @foreach (var exp in Profile.WorkExperience)
        {
            var index = Profile.WorkExperience.IndexOf(exp);
            var isFirst = index == 0;
            var isLast = index == Profile.WorkExperience.Count - 1;

            <MudCard Class="pa-3" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="exp.CompanyName" Label="@Localizer["Company"]"
                                      Variant="Variant.Text" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Business" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="exp.JobTitle" Label="@Localizer["JobTitle"]"
                                      Variant="Variant.Text" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Work" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="exp.Location" Label="@Localizer["Location"]"
                                      Variant="Variant.Text" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.LocationOn" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudDatePicker @bind-Date="exp.StartDate" Label="@Localizer["StartDate"]" />
                    </MudItem>
                    <MudItem xs="12" sm="2">
                        <MudDatePicker @bind-Date="exp.EndDate"
                                       Label="@(exp.IsCurrentRole ? Localizer["Present"].Value : Localizer["EndDate"].Value)"
                                       Disabled="@exp.IsCurrentRole" />
                    </MudItem>
                    <MudItem xs="4" sm="2" Class="d-flex align-center">
                        @if (!exp.IsCurrentRole)
                        {
                            <MudChip T="string"
                                     Color="Color.Info"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @CalculateDuration(exp.StartDate, exp.EndDate, exp.IsCurrentRole)
                            </MudChip>
                        }
                    </MudItem>

                    <MudItem xs="4" sm="3" Class="d-flex align-center">
                        <MudSwitch T="bool"
                                   @bind-Value="exp.IsCurrentRole"
                                   Color="Color.Primary"
                                   Label="@Localizer["CurrentRole"]" />
                    </MudItem>

                    <MudItem xs="12" sm="3" Class="d-flex justify-end align-center">
                        <MudTooltip Text="@Localizer["MoveUp"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" 
                                           Disabled="@isFirst" 
                                           OnClick="@(() => MoveExperienceUp(exp))" 
                                           Size="Size.Small" 
                                           Color="Color.Default"
                                           Class="mr-1" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer["MoveDown"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" 
                                           Disabled="@isLast" 
                                           OnClick="@(() => MoveExperienceDown(exp))" 
                                           Size="Size.Small" 
                                           Color="Color.Default"
                                           Class="mr-4" />
                        </MudTooltip>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveExperience(exp))"
                                   StartIcon="@Icons.Material.Filled.Delete">
                            @Localizer["Remove"]
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" Class="pt-2">
                        <MudTextField @bind-Value="exp.Description" Label="@Localizer["Description"]" Lines="3"
                                      Sizing="InputSizing.Auto" Variant="Variant.Outlined" Clearable="true" />
                    </MudItem>
                </MudGrid>
            </MudCard>
        }
    </MudStack>
}

