@if (Profile != null)
{
    <SectionHeaderCard Section="Profile.ExperienceSection" DefaultNameKey="WorkExperienceCv" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddExperience" Class="mb-2" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add">@Localizer["AddExperience"]</MudButton>
    <MudStack Spacing="4">
        @foreach (var exp in Profile.WorkExperience)
        {
            var index = Profile.WorkExperience.IndexOf(exp);
            var isFirst = index == 0;
            var isLast = index == Profile.WorkExperience.Count - 1;

            <MudCard Class="pa-3" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="exp.CompanyName" Label="@Localizer["Company"]" Clearable="true"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start" Margin="Margin.Dense"
                                      AdornmentIcon="@Icons.Material.Filled.Business" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="exp.JobTitle" Label="@Localizer["JobTitle"]" Clearable="true"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start" Margin="Margin.Dense"
                                      AdornmentIcon="@Icons.Material.Filled.Work" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField @bind-Value="exp.Location" Label="@Localizer["Location"]" Clearable="true"
                                      Variant="Variant.Outlined" Adornment="Adornment.Start" Margin="Margin.Dense"
                                      AdornmentIcon="@Icons.Material.Filled.LocationOn" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="pt-1">
                        <MudDatePicker @bind-Date="exp.StartDate" Label="@Localizer["StartDate"]" OpenTo="OpenTo.Month" FixDay="1" DateFormat="MM/yyyy" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="pt-1">
                        <MudDatePicker @bind-Date="exp.EndDate" Label="@(exp.IsCurrentRole ? Localizer["Present"].Value : Localizer["EndDate"].Value)" Disabled="@exp.IsCurrentRole" OpenTo="OpenTo.Month" FixDay="1" DateFormat="MM/yyyy" Margin="Margin.Dense" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="4" sm="2" Class="d-flex align-center pt-1">
                        @if (!exp.IsCurrentRole)
                        {
                            <MudChip T="string"
                                     Color="Color.Info"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small">
                                @CalculateDuration(exp.StartDate, exp.EndDate, exp.IsCurrentRole)
                            </MudChip>
                        }
                    </MudItem>

                    <MudItem xs="4" sm="3" Class="d-flex align-center pt-1">
                        <MudSwitch T="bool" Size="Size.Small"
                                   @bind-Value="exp.IsCurrentRole"
                                   Color="Color.Primary"
                                   Label="@Localizer["CurrentRole"]" />
                    </MudItem>

                    <MudItem xs="12" sm="3" Class="d-flex justify-end align-center pt-1">
                        <MudTooltip Text="@Localizer["MoveUp"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                           Disabled="@isFirst"
                                           OnClick="@(() => MoveExperienceUp(exp))"
                                           Size="Size.Small"
                                           Class="mr-1" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer["MoveDown"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                           Disabled="@isLast"
                                           OnClick="@(() => MoveExperienceDown(exp))"
                                           Size="Size.Small"
                                           Class="mr-4" />
                        </MudTooltip>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveExperience(exp))"
                                   StartIcon="@Icons.Material.Filled.Delete">
                            @Localizer["Remove"]
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" Class="pt-1">
                        <MudTextField @bind-Value="exp.Description" Label="@Localizer["Description"]"
                                      Sizing="InputSizing.Auto" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" />
                    </MudItem>
                </MudGrid>
            </MudCard>
        }
    </MudStack>
}

