@if (Profile != null)
{
    <SectionHeaderCard Section="Profile.CoreCompetenciesSection" DefaultNameKey="CoreCompetencies" />

    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddCategory" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add">@Localizer["AddCategory"]</MudButton>
        @if (_showChipHelp)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Icon="@Icons.Material.Filled.Info" ShowCloseIcon="true" CloseIconClicked="() => _showChipHelp = false" Class="profile-chip-help-row">
                @Localizer["SkillsHelper"]
            </MudAlert>
        }
        <MudSwitch T="bool" @bind-Value="Profile.CoreCompetenciesSection.DisplayAsChips" Color="Color.Primary" Label="@Localizer["DisplayAsChips"]" Class="ml-auto" />
    </MudStack>

    <MudStack Spacing="4" Class="pt-2">
        @foreach (var category in CoreCompetencyCategories)
        {
            var index = CoreCompetencyCategories.IndexOf(category);
            var isFirst = index == 0;
            var isLast = index == CoreCompetencyCategories.Count - 1;

            <MudCard Class="pb-1 pt-3 pl-3 pr-3" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="5">
                        <MudTextField @bind-Value="category.Name" Label="@Localizer["CategoryName"]" Variant="Variant.Text" />
                    </MudItem>
                    <MudItem xs="12" sm="5" Class="d-flex align-center">
                        <MudTextField Class="" @bind-Value="category.NewSkillInput"
                                      Label="@((_editingSkillCategory == category && _editingSkillOriginalValue != null) ? Localizer["Edit"].Value : $"{Localizer["AddSkill"]} {category.Name}")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Adornment="Adornment.End" AdornmentIcon="@((_editingSkillCategory == category && _editingSkillOriginalValue != null) ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                                      OnAdornmentClick="@(() => AddSkill(category))" Immediate="true" />
                        @if (_editingSkillCategory == category && _editingSkillOriginalValue != null)
                        {
                            <MudTooltip Text="@Localizer["Cancel"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => CancelSkillEdit(category))" Class="ml-2" />
                            </MudTooltip>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex justify-end align-center">
                        <MudTooltip Text="@Localizer["MoveUp"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                           Disabled="@isFirst"
                                           OnClick="@(() => MoveCategoryUp(category))"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           Class="mr-1" />
                        </MudTooltip>
                        <MudTooltip Text="@Localizer["MoveDown"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                           Disabled="@isLast"
                                           OnClick="@(() => MoveCategoryDown(category))"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           Class="mr-4" />
                        </MudTooltip>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveCategory(category))"
                                   StartIcon="@Icons.Material.Filled.Delete">
                            @Localizer["Remove"]
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" Class="pt-0 pb-0">
                        <div class="profile-chip-container">
                            @foreach (var skill in category.Skills)
                            {
                                var skillIndex = category.Skills.IndexOf(skill);
                                var isFirstSkill = skillIndex == 0;
                                var isLastSkill = skillIndex == category.Skills.Count - 1;

                                <MudChip T="string" Value="@skill" Color="Color.Primary" Variant="Variant.Text"
                                         Class="profile-chip">
                                    <span class="profile-chip-content">
                                        <FormattedText Text="@skill" />
                                        <span class="profile-chip-edit-action" @onclick:stopPropagation="true">
                                            <MudTooltip Text="@Localizer["MoveLeft"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                               Disabled="@isFirstSkill"
                                                               Size="Size.Small"
                                                               Color="Color.Default"
                                                               Variant="Variant.Text"
                                                               OnClick="@(() => MoveSkillLeft(category, skill))" />
                                            </MudTooltip>
                                            <MudTooltip Text="@Localizer["MoveRight"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                               Disabled="@isLastSkill"
                                                               Size="Size.Small"
                                                               Color="Color.Default"
                                                               Variant="Variant.Text"
                                                               OnClick="@(() => MoveSkillRight(category, skill))" />
                                            </MudTooltip>
                                            <MudTooltip Text="@Localizer["Edit"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                               Size="Size.Small"
                                                               Color="Color.Default"
                                                               Variant="Variant.Text"
                                                               OnClick="@(() => BeginSkillEdit(category, skill))" />
                                            </MudTooltip>
                                            <MudTooltip Text="@Localizer["Remove"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                               Size="Size.Small"
                                                               Color="Color.Default"
                                                               Variant="Variant.Text"
                                                               OnClick="@(() => RemoveSkill(category, skill))" />
                                            </MudTooltip>
                                        </span>
                                    </span>
                                </MudChip>
                            }
                        </div>
                    </MudItem>
                </MudGrid>
            </MudCard>
        }
    </MudStack>
}

