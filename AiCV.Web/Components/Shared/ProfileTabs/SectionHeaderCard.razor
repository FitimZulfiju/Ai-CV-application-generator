<MudCard Class="mb-2 mud-elevation-1 card-floating-title" Style="background-color: var(--mud-palette-background-grey);">
    <MudCardContent Class="pt-1 pb-0">
        <MudGrid Spacing="2" Class="section-header-grid">
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="Section.Title"
                              Label="@($"{Localizer["CustomSectionHeader"]} ({Localizer["LeaveBlankToUseDefault", Localizer[DefaultNameKey]]})")"
                              Variant="Variant.Text" Margin="Margin.Dense" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <UnicodeIconPicker @bind-Icon="Section.Icon" Label="@Localizer["SectionIcon"]" Variant="Variant.Text" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>
