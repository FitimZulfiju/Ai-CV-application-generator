@if (Profile != null)
{

    var proficiencyLabel = $"{Localizer["Proficiency"]} ({Localizer["LanguageProficiencyHelper"]})";
    var isEditing = _editingLanguage != null;

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudButton StartIcon="@(isEditing ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)"
                   Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SaveLanguage">
            @(isEditing ? Localizer["Update"] : Localizer["AddLanguage"])
        </MudButton>
        @if (isEditing)
        {
            <MudTooltip Text="@Localizer["Cancel"]">
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Default"
                               Variant="Variant.Outlined"
                               OnClick="CancelLanguageEdit" />
            </MudTooltip>
        }
    </MudStack>

    <MudStack Spacing="4" Class="pt-2">

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_newLanguageName"
                              Label="@Localizer["Language"]"
                              Variant="Variant.Outlined"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_newLanguageProficiency"
                              Label="@proficiencyLabel"
                              Variant="Variant.Outlined"
                              Immediate="true" />
            </MudItem>
        </MudGrid>

        <MudDropContainer @ref="_dropContainer"
                          T="Language"
                          Items="Profile.Languages"
                          ItemsSelector="@((Language item, string zone) => zone == LanguagesDropZone)"
                          ItemDropped="OnLanguageDropped"
                          Class="profile-chip-drop-container">
            <ChildContent>
                <MudDropZone T="Language"
                             Identifier="@LanguagesDropZone"
                             AllowReorder="true"
                             Class="profile-chip-drop-zone" />
            </ChildContent>
            <ItemRenderer>
                @{
                    var chipText = GetLanguageChipText(context);
                }

                <MudChip T="Language"
                         Value="context"
                         Color="@GetLanguageChipColor(context)"
                         Variant="@GetLanguageChipVariant(context)"
                         OnClose="@((MudChip<Language> chip) => RemoveLanguage(context))"
                         Class="profile-draggable-chip">
                    <span class="profile-chip-content">
                        <FormattedText Text="@chipText" />
                        <span class="profile-chip-edit-action" @onclick:stopPropagation="true">
                            <MudTooltip Text="@Localizer["Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               Variant="Variant.Text"
                                               OnClick="@(() => BeginLanguageEdit(context))" />
                            </MudTooltip>
                        </span>
                    </span>
                </MudChip>
            </ItemRenderer>
        </MudDropContainer>

        @if (_showChipHelp)
        {
            <MudAlert Severity="Severity.Info"
                      Variant="Variant.Text"
                      Dense="true"
                      Icon="@Icons.Material.Filled.Info"
                      ShowCloseIcon="true"
                      CloseIconClicked="() => _showChipHelp = false"
                      Class="profile-chip-help-row">
                @Localizer["ProfileChipHelp"]
            </MudAlert>
        }
    </MudStack>
}
