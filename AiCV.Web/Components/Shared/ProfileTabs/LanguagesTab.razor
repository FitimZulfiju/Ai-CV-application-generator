@if (Profile != null)
{
    <SectionHeaderCard Section="Profile.LanguagesSection" DefaultNameKey="LanguagesCv" />

    var proficiencyLabel = $"{Localizer["Proficiency"]} ({Localizer["LanguageProficiencyHelper"]})";
    var isEditing = _editingLanguage != null;

    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        <MudButton StartIcon="@(isEditing ? Icons.Material.Filled.Check : Icons.Material.Filled.Add)" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveLanguage">
            @(isEditing ? Localizer["Update"] : Localizer["AddLanguage"])
        </MudButton>
        @if (_showChipHelp)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Icon="@Icons.Material.Filled.Info" ShowCloseIcon="true" CloseIconClicked="() => _showChipHelp = false" Class="profile-chip-help-row">
                @Localizer["ProfileChipHelp"]
            </MudAlert>
        }
        @if (isEditing)
        {
            <MudTooltip Text="@Localizer["Cancel"]">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Variant="Variant.Outlined" OnClick="CancelLanguageEdit" />
            </MudTooltip>
        }
        <MudSwitch T="bool" @bind-Value="Profile.LanguagesSection.DisplayAsChips" Color="Color.Primary" Label="@Localizer["DisplayAsChips"]" Class="ml-auto" />
    </MudStack>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_newLanguageName" Label="@Localizer["Language"]" Variant="Variant.Outlined" Clearable="true" Immediate="true" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="_newLanguageProficiency" Label="@proficiencyLabel" Variant="Variant.Outlined" Clearable="true" Immediate="true" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>

    <MudStack Spacing="4" Class="pt-0 pb-0">
        <div class="profile-chip-container">
            @foreach (var language in Profile.Languages)
            {
                var languageIndex = Profile.Languages.IndexOf(language);
                var isFirstLanguage = languageIndex == 0;
                var isLastLanguage = languageIndex == Profile.Languages.Count - 1;
                var chipText = GetLanguageChipText(language);

                <MudChip T="Language" Value="language" Color="@GetLanguageChipColor(language)" Variant="@GetLanguageChipVariant(language)" Class="profile-chip">
                    <span class="profile-chip-content">
                        <FormattedText Text="@chipText" />
                        <span class="profile-chip-edit-action" @onclick:stopPropagation="true">
                            <MudTooltip Text="@Localizer["MoveLeft"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@isFirstLanguage" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" OnClick="@(() => MoveLanguageLeft(language))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["MoveRight"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@isLastLanguage" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" OnClick="@(() => MoveLanguageRight(language))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["Edit"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" OnClick="@(() => BeginLanguageEdit(language))" />
                            </MudTooltip>
                            <MudTooltip Text="@Localizer["Remove"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" OnClick="@(() => RemoveLanguage(language))" />
                            </MudTooltip>
                        </span>
                    </span>
                </MudChip>
            }
        </div>
    </MudStack>
}

