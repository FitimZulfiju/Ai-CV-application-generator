<MudCard Elevation="0" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-4">@Localizer["CustomFooter"]</MudText>
    <MudTextField @bind-Value="Profile.FooterText"
                  Label="@Localizer["FooterText"]"
                  Lines="3"
                  Variant="Variant.Outlined"
                  Placeholder="@Localizer["ReferencesAvailableUponRequest"]"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.ShortText"
                  HelperText="@Localizer["SupportsMarkdown"]" />
</MudCard>

