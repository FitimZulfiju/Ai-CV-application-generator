<MudDialog>
    <TitleContent>
        <MudStack Row AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
            <MudText Typo="Typo.h6">Sample CV - Reference</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="d-flex justify-center" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden; background-color: var(--mud-palette-background-grey); padding: 1rem;">
            <div style="transform: scale(0.85); transform-origin: top center; transition: transform 0.2s ease-in-out;">
                <CvPreview Profile="@_profile" Template="@AiCV.Domain.Constants.CvTemplates.Professional" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>
